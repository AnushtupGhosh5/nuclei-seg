{
  "data_root": "data/monusac_dataset",
  "output_dir": "outputs/pde_geometric_mamba_monusac_hybrid",
  "pretrained_checkpoint": "outputs/pretrained/vmamba_tiny_e292.pth",
  "split_csv": "data/monusac_dataset/split.csv",
  "type_encoding": "monusac_4class",
  "type_classes": [
    "background",
    "epithelial",
    "lymphocyte",
    "macrophage",
    "neutrophil"
  ],
  "strict_official_split": false,
  "seed": 42,
  "patch_size": 256,
  "infer_overlap": 64,
  "batch_size": 2,
  "infer_batch_size": 2,
  "patches_per_tile": 12,
  "epochs": 200,
  "learning_rate": 0.0001,
  "pretrained_learning_rate": 0.00001,
  "weight_decay": 0.0,
  "num_workers": 2,
  "val_fraction": 0.15,
  "eval_every": 5,
  "magnification": 40,
  "match_iou": 0.5,
  "min_foreground_fraction": 0.01,
  "early_stopping_patience": 4,
  "amp": false,
  "deterministic": true,
  "smoke_test": false,
  "resume_checkpoint": null,
  "scan_mode": "hybrid",
  "pde_scan_stages": ["encoder_2", "encoder_3", "decoder_1"],
  "guide_source_stage": 1,
  "guide_detach_for_sort": true,
  "num_pde_bins": 16,
  "pde_scan_window": 4,
  "pde_target_iterations": 48,
  "mask_loss_weight": 1.0,
  "field_loss_weight": 1.0,
  "type_loss_weight": 1.0,
  "guide_loss_weight": 0.5,
  "field_background_weight": 0.1,
  "nucleus_threshold": 0.5,
  "marker_threshold": 0.22,
  "minimum_peak_distance": 9,
  "minimum_object_size": 10,
  "field_smoothing_sigma": 1.5,
  "visualization_count": 5
}
